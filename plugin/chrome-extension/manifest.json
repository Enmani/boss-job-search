{
  "manifest_version": 3,
  "name": "直聘求职",
  "version": "0.2.0",
  "description": "让本机 Codex 搜索 BOSS 岗位并读取完整详情。",
  "minimum_chrome_version": "105",
  "permissions": ["scripting", "nativeMessaging", "alarms", "storage"],
